# --- Secure AI sandbox -------------------------------------------------------
# Enterprise Claude API key. Data sent to the API is not used for training.
ANTHROPIC_API_KEY=sk-ant-...
DAM_MODEL=claude-opus-4-8

# --- Database (PostgreSQL + pgvector) ---------------------------------------
# Compose maps the database to host port 55432 (5432 inside the network)
DATABASE_URL=postgresql+asyncpg://dam:dam@localhost:55432/dam_governance

# --- Object store (MinIO) ----------------------------------------------------
# Compose maps MinIO to host port 59000 (9000 inside the network)
MINIO_ENDPOINT=localhost:59000
MINIO_ACCESS_KEY=dam-admin
MINIO_SECRET_KEY=dam-secret
MINIO_BUCKET=governance-documents

# --- App ----------------------------------------------------------------------
DAM_ENV=development
DAM_AUDIT_LOG_PATH=./data/audit

# --- Adapter selection (hexagonal seams) ---------------------------------------
# repo: postgres | memory · storage: minio | local · auth: dev | oidc
REPO_BACKEND=postgres
STORAGE_BACKEND=minio
AUTH_MODE=dev

# --- Document source (OneDrive / SharePoint) -----------------------------------
# none = upload only · local = dev folder twin · graph = Microsoft 365
DOC_SOURCE=none
LOCAL_SOURCE_PATH=./data/source
# Microsoft Graph app-only credentials (OneDrive drive or SharePoint library drive)
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_DRIVE_ID=
